# Docker Compose defaults. No API key is required.
POSTGRES_DB=lead_intelligence
POSTGRES_USER=lead_user
POSTGRES_PASSWORD=lead_password
DATABASE_URL=postgresql+psycopg://lead_user:lead_password@db:5432/lead_intelligence
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_URL=/api

# Reserved for a future optional provider. The current app never calls an AI API.
OPENAI_API_KEY=
